{
    "version": 2,
    "builds": [
        {
            "src": "frontend/package.json",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "dist/library-ui/browser"
            }
        },
        {
            "src": "backend-node/src/index.ts",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "backend-node/src/index.ts"
        },
        {
            "src": "/(assets/.*)",
            "dest": "/frontend/$1"
        },
        {
            "src": "/(.*\\.js)",
            "dest": "/frontend/$1"
        },
        {
            "src": "/(.*\\.css)",
            "dest": "/frontend/$1"
        },
        {
            "src": "/(.*\\.png)",
            "dest": "/frontend/$1"
        },
        {
            "src": "/(.*\\.jpg)",
            "dest": "/frontend/$1"
        },
        {
            "src": "/(.*\\.svg)",
            "dest": "/frontend/$1"
        },
        {
            "src": "/(.*\\.ico)",
            "dest": "/frontend/$1"
        },
        {
            "src": "/(.*)",
            "status": 200,
            "dest": "/frontend/index.html"
        }
    ]
}